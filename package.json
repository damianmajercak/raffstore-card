  "description": "Home Assistant Lovelace card for exterior venetian blinds (raffstore) – set height and slat angle visually in one card.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damianmajercak/raffstore-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "venetian-blinds",
    "raffstore",
